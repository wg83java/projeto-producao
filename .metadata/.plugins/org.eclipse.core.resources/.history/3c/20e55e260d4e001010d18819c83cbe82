		String[] listacabos = {"cb1.5mm","cb2.5mm","cb4mm","cb6mm","cb10mm","cb16mm","cb25mm","cb35mm","cb50mm"};
        
		for(String cabo : listacabos) {
			
			List<ControllerPedido> pedidos = findByNameProduto(cabo);
			
			List<Long> idpedidos = new ArrayList<>();
